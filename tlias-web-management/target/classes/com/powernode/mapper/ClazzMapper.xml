<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.powernode.mapper.ClazzMapper">
    <insert id="insert">
        insert into clazz (name,room,begin_date,end_date,master_id,subject,create_time,update_time)
        values (#{name},#{room},#{beginDate},#{endDate},#{masterId},#{subject},#{createTime},#{updateTime})
    </insert>

    <update id="update">
        update clazz
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="room != null and room != ''">
                room = #{room},
            </if>
            <if test="beginDate != null">
                begin_date = #{beginDate},
            </if>
            <if test="endDate != null">
                end_date = #{endDate},
            </if>
            <if test="masterId != null">
                master_id = #{masterId},
            </if>
            <if test="subject != null">
                subject = #{subject},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>
    <delete id="deleteById">
        delete from clazz where id = #{id}
    </delete>

    <select id="list" resultType="com.powernode.pojo.Clazz">
        select c.*,
        e.name masterName,
        case
        when c.begin_date > CURDATE() then '未开班'
        when c.begin_date &lt;= CURDATE() and c.end_date &gt;= CURDATE() then '在读'
        when c.end_date &lt; CURDATE() then '已结课'
        else '未知'
        end as status
        from clazz c
        left join emp e on c.master_id = e.id
        <where>
            <if test="name!=null and name!=''">
                c.name like concat('%',#{name},'%')
            </if>
            <if test="masterId!=null">
                and c.master_id = #{masterId}
            </if>
            <if test="begin != null">
                and c.end_date &gt;= #{begin}
            </if>
            <if test="end != null">
                and c.end_date &lt;= #{end}
            </if>
            <if test="status != null and status != ''">
                <choose>
                    <when test='status.equals("未开班")'>
                        and c.begin_date &gt; CURDATE()
                    </when>
                    <when test='status.equals("在读")'>
                        and c.begin_date &lt;= CURDATE() and c.end_date &gt;= CURDATE()
                    </when>
                    <when test='status.equals("已结课")'>
                        and c.end_date &lt; CURDATE()
                    </when>
                    <otherwise>
                        and 1=1
                    </otherwise>
                </choose>
            </if>
        </where>
        order by c.update_time desc
    </select>
    <select id="getInfo" resultType="com.powernode.pojo.Clazz">
        select clazz.* from clazz where id = #{id}
    </select>
    <select id="listAll" resultType="com.powernode.pojo.Clazz">
        select id,name,room,begin_date,end_date,master_id,subject,create_time,update_time
        from clazz
        order by create_time desc
    </select>
</mapper>
